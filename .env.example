APP_NAME="Outreach CRM"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://outreach.click
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL runs on the same server as the website.
# Never use the srvNNNN.hstgr.io host from the application itself.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u311221303_outrach
DB_USERNAME=u311221303_admin
DB_PASSWORD=your_database_password

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# Leave SESSION_DOMAIN empty unless cookies must be shared across subdomains.
SESSION_DOMAIN=

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Outgoing mail (SMTP credentials for the mailbox used to send campaigns).
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@outreach.click"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed when the frontend is rebuilt (`npm run build`) during deployment.
VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=outreach.click

CRM_DEFAULT_TIMEZONE=UTC
CRM_DAILY_SEND_LIMIT=20
