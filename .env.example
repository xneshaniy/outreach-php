APP_NAME="Outreach CRM"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://outreach.click
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Cache / Queue / Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=admin@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security (Sanctum / Session)
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SESSION_DOMAIN=yourdomain.com
SESSION_SECURE_COOKIE=true

# CRM Settings
CRM_DEFAULT_TIMEZONE=UTC
CRM_DAILY_SEND_LIMIT=200
CRM_BATCH_SIZE=50
CRM_MAX_RETRIES=3
CRM_RETRY_DELAY=300

# Super Admin Email (for system notifications)
ADMIN_EMAIL=admin@yourdomain.com

# AI Provider (Optional - for AI lead research and personalization)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# AI Cost Estimation (tokens per USD - update to match your provider pricing)
# AI_INPUT_TOKEN_COST=0.000001
# AI_OUTPUT_TOKEN_COST=0.000003
